FROM node:24-bookworm-slim AS frontend
WORKDIR /ui
COPY web/frontend/package.json web/frontend/package-lock.json ./
RUN npm ci
COPY web/frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /project
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8
ENV PYTHONPATH=/project/src CHAT_DB_PATH=/project/output/web/chat.sqlite3
COPY requirements.txt requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements-web.txt
COPY run.py ./
COPY src/ ./src/
COPY configs/ ./configs/
COPY models/grammar/ ./models/grammar/
COPY data/raw/ ./data/raw/
COPY data/slide_content/ ./data/slide_content/
COPY data/evaluation/ ./data/evaluation/
COPY input/ ./input/
RUN python -B run.py build-kb
COPY --from=frontend /ui/dist/ ./web/frontend/dist/
RUN mkdir -p output/web
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4)"
CMD ["python", "-m", "uvicorn", "course_assistant.web.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
